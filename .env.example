# Copy to .env.local for local development. Never commit the real file.
# Everything NEXT_PUBLIC_* is shipped to the browser — never put a secret here.
# The frontend holds no JWT secret: it never verifies tokens (ADR-012, ADR-013).

# Server-only (dev): where Next proxies /api/* to. Leave unset when an ingress
# routes /api/* to the backend on the same origin.
API_PROXY_TARGET=http://127.0.0.1:8000

# Same-origin path of the versioned API. Must start with "/".
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# local | test | staging | production
NEXT_PUBLIC_APP_ENV=local
