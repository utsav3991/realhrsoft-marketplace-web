# Copy to .env.local for local development. Never commit the real file.
# Everything NEXT_PUBLIC_* is shipped to the browser — never put a secret here.
# The frontend holds no JWT secret: it never verifies tokens (ADR-012, ADR-013).

# Server-only (dev): where Next proxies /api/* to (the Django backend, run with
# FORCE_SCRIPT_NAME unset). Leave unset when an ingress serves the backend on the same origin.
API_PROXY_TARGET=http://127.0.0.1:8000

# Same-origin path of the versioned API. Must start with "/" and equal Django's
# {FORCE_SCRIPT_NAME}/api/v1, because the refresh cookie is scoped to that path + /auth.
# Local: /api/v1. Behind infra/nginx (FORCE_SCRIPT_NAME=/backend): /backend/api/v1.
NEXT_PUBLIC_API_BASE_PATH=/api/v1

# local | test | staging | production
NEXT_PUBLIC_APP_ENV=local
