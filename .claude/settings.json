{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn dev*)",
      "Bash(yarn build*)",
      "Bash(yarn lint*)",
      "Bash(yarn type-check*)",
      "Bash(yarn test*)",
      "Bash(yarn check*)",
      "Bash(yarn format*)",
      "Bash(yarn api:generate*)",
      "Bash(yarn install*)",
      "Bash(yarn prettier*)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./e2e/**)",
      "Write(./src/**)",
      "Write(./e2e/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(rm -rf*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Edit(./src/generated/**)",
      "Write(./src/generated/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-save.sh"
          }
        ]
      }
    ]
  }
}
